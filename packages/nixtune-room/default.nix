# nixtune-room, the multiroom daemon, built with nixpkgs' Haskell set.
#
# Written out rather than generated by callCabal2nix, which would make
# every evaluation of the flake build cabal2nix first (import from
# derivation). The dependency lists mirror nixtune-room.cabal; a library
# added there is added here. Boot libraries (base, bytestring and the
# rest) evaluate to null in haskellPackages and are listed for parity with
# the cabal file.
#
# The test suite runs in the build, so a package that builds has passed
# it. DaemonSpec talks over loopback sockets, which the build sandbox
# allows.
{
  lib,
  haskellPackages,
}:
let
  hp = haskellPackages;
in
hp.mkDerivation {
  pname = "nixtune-room";
  version = "0.3.0.0";
  src = lib.fileset.toSource {
    root = ./.;
    fileset = lib.fileset.unions [
      ./nixtune-room.cabal
      ./app
      ./src
      ./test
    ];
  };
  isLibrary = true;
  isExecutable = true;
  libraryHaskellDepends = with hp; [
    aeson
    async
    base
    bytestring
    containers
    crypton
    directory
    filepath
    memory
    network
    stm
    text
    unix
    websockets
  ];
  executableHaskellDepends = with hp; [
    base
    bytestring
    directory
    filepath
    network
    optparse-applicative
    text
    unix
  ];
  testHaskellDepends = with hp; [
    aeson
    async
    base
    bytestring
    containers
    directory
    filepath
    hspec
    memory
    network
    QuickCheck
    stm
    text
    unix
  ];
  testFlags = [ "--qc-max-success=1000" ];
  homepage = "https://github.com/harryprayiv/nixtune";
  description = "The nixtune multiroom daemon: coordinator and Sendspin server";
  license = lib.licenses.agpl3Plus;
  mainProgram = "nixtune-room";
}