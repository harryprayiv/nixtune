diff --git a/tests/daemon/test_daemon.py b/tests/daemon/test_daemon.py
index 04ab5be..0f50736 100644
--- a/tests/daemon/test_daemon.py
+++ b/tests/daemon/test_daemon.py
@@ -202,3 +202,33 @@ def test_last_playback_server_is_seeded_from_settings(
         return await store.get_last_playback_server_id()
 
     assert asyncio.run(run()) == expected
+
+
+def test_stop_hook_names_the_server_whose_stream_it_was(tmp_path: Path, monkeypatch) -> None:
+    """A stop reported after the server disconnected still carries its server_id."""
+    import sendspin.daemon.daemon as daemon_module
+
+    calls: list[dict[str, object]] = []
+
+    async def record(hook: str, **kwargs: object) -> None:
+        calls.append({"hook": hook, **kwargs})
+
+    monkeypatch.setattr(daemon_module, "run_hook", record)
+    daemon = _make_daemon(tmp_path, settings_volume=25, settings_muted=False)
+    daemon._args.hook_start = "start-hook"
+    daemon._args.hook_stop = "stop-hook"
+    client = SimpleNamespace(server_info=SimpleNamespace(server_id="lab-server", name="lab"))
+    daemon._client = client  # type: ignore[assignment]
+
+    async def run() -> None:
+        daemon._on_stream_event("start")
+        client.server_info = None  # the server has disconnected
+        daemon._on_stream_event("stop")
+        await asyncio.sleep(0)
+
+    asyncio.run(run())
+
+    assert [(c["hook"], c["server_id"]) for c in calls] == [
+        ("start-hook", "lab-server"),
+        ("stop-hook", "lab-server"),
+    ]
diff --git a/tests/test_audio_connector.py b/tests/test_audio_connector.py
index c785e67..4276962 100644
--- a/tests/test_audio_connector.py
+++ b/tests/test_audio_connector.py
@@ -1,6 +1,8 @@
 from __future__ import annotations
 
 import asyncio
+import threading
+import time
 from types import SimpleNamespace
 
 import sendspin.audio_connector as audio_connector
@@ -322,3 +324,120 @@ def test_audio_waits_for_the_start_hook(monkeypatch) -> None:
         assert _FakeWorker.instances[-1].submitted == [(2, b"after", fmt)]
 
     asyncio.run(exercise())
+
+
+class _ReleasingWorker(_FakeWorker):
+    """A worker whose stream closes only when the test says so."""
+
+    def __init__(self, **kwargs: object) -> None:
+        super().__init__(**kwargs)  # type: ignore[arg-type]
+        self.released = threading.Event()
+
+    def close_stream(self) -> threading.Event:  # type: ignore[override]
+        self.stream_closed = True
+        return self.released
+
+
+def _started_handler(events: list[str]) -> AudioStreamHandler:
+    handler = AudioStreamHandler(
+        audio_device=SimpleNamespace(index=0, name="Fake Device"),
+        volume=100,
+        muted=False,
+        on_event=events.append,
+    )
+    handler.attach_client(_FakeClient())
+    handler._on_stream_start(
+        SimpleNamespace(payload=SimpleNamespace(player=SimpleNamespace(), visualizer=None))
+    )
+    return handler
+
+
+def test_stop_is_reported_once_the_device_is_released(monkeypatch) -> None:
+    """A stop hook may hand the device to another program, so it runs after the close."""
+    monkeypatch.setattr(audio_connector, "_AudioSyncWorker", _ReleasingWorker)
+    _FakeWorker.instances.clear()
+
+    async def exercise() -> None:
+        events: list[str] = []
+        handler = _started_handler(events)
+        worker = _FakeWorker.instances[-1]
+        assert isinstance(worker, _ReleasingWorker)
+        assert events == ["start"]
+
+        handler._on_stream_end(None)
+        await asyncio.sleep(0.05)
+        assert events == ["start"], "stop reported before the device was released"
+
+        worker.released.set()
+        assert handler._reported is not None
+        await handler._reported
+        assert events == ["start", "stop"]
+
+    asyncio.run(exercise())
+
+
+def test_a_start_after_a_pending_stop_is_reported_after_it(monkeypatch) -> None:
+    """Events keep their order, and audio waits for the start to be reported."""
+    monkeypatch.setattr(audio_connector, "_AudioSyncWorker", _ReleasingWorker)
+    _FakeWorker.instances.clear()
+
+    async def exercise() -> None:
+        events: list[str] = []
+        handler = _started_handler(events)
+        worker = _FakeWorker.instances[-1]
+        assert isinstance(worker, _ReleasingWorker)
+
+        handler._on_stream_end(None)
+        handler._on_stream_start(
+            SimpleNamespace(payload=SimpleNamespace(player=SimpleNamespace(), visualizer=None))
+        )
+        fmt = _make_format()
+        handler._on_audio_chunk(1, b"early", fmt, 0)
+        assert worker.submitted == []
+        assert events == ["start"]
+
+        worker.released.set()
+        assert handler._reported is not None
+        await handler._reported
+        assert events == ["start", "stop", "start"]
+        handler._on_audio_chunk(2, b"after", fmt, 0)
+        assert worker.submitted == [(2, b"after", fmt)]
+
+    asyncio.run(exercise())
+
+
+def test_the_worker_reports_the_stream_closed(monkeypatch) -> None:
+    """The real worker sets the event only after the player has closed its stream."""
+    closed: list[bool] = []
+
+    class _Player:
+        def __init__(self, *args: object, **kwargs: object) -> None:
+            pass
+
+        def set_volume(self, volume: int, *, muted: bool) -> None:
+            pass
+
+        def close_stream(self) -> None:
+            time.sleep(0.05)
+            closed.append(True)
+
+        def stop(self) -> None:
+            pass
+
+    monkeypatch.setattr(audio_connector, "AudioPlayer", _Player)
+
+    async def exercise() -> None:
+        worker = audio_connector._AudioSyncWorker(
+            audio_device=SimpleNamespace(index=0, name="Fake Device"),
+            use_software_volume=True,
+            volume=100,
+            muted=False,
+        )
+        client = _FakeClient()
+        worker.start(client.compute_play_time, client.compute_server_time)
+        released = worker.close_stream()
+        assert released.wait(2.0)
+        assert closed == [True]
+        await worker.stop()
+
+    asyncio.run(exercise())
