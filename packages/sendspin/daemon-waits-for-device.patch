diff --git a/tests/test_audio_devices.py b/tests/test_audio_devices.py
index 7db483c..39c17e9 100644
--- a/tests/test_audio_devices.py
+++ b/tests/test_audio_devices.py
@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import asyncio
 from unittest.mock import patch
 
 import sounddevice
@@ -157,3 +158,70 @@ def test_detect_supported_audio_formats_falls_back_for_alsa_only_device():
         formats = detect_supported_audio_formats(_alsa_only_device())
 
     assert formats, "expected safe-default formats for an unprobeable device"
+
+
+def _nixtune_device() -> AudioDevice:
+    return AudioDevice(
+        index=10, name="nixtune", output_channels=2, sample_rate=44100.0, is_default=False
+    )
+
+
+def test_wait_for_audio_device_rescans_until_the_device_is_listed():
+    """A device another program holds may be missing from the list until it is let go."""
+    device = _nixtune_device()
+    answers: list[AudioDevice | None] = [None, None, device]
+    rescans: list[bool] = []
+
+    def resolve(_arg: str | None) -> AudioDevice:
+        answer = answers.pop(0)
+        if answer is None:
+            raise ValueError("Audio device 'nixtune' not found.")
+        return answer
+
+    with (
+        patch.object(_mod, "resolve_audio_device", side_effect=resolve),
+        patch.object(_mod, "rescan_audio_devices", side_effect=lambda: rescans.append(True)),
+        patch.object(sounddevice, "check_output_settings"),
+    ):
+        result = asyncio.run(_mod.wait_for_audio_device("nixtune", interval=0))
+
+    assert result is device
+    assert rescans == [True, True]
+
+
+def test_wait_for_audio_device_waits_while_a_listed_device_is_busy():
+    """A listed device that another program has open is waited for too."""
+    device = _nixtune_device()
+    busy = [True, False]
+    rescans: list[bool] = []
+
+    def check(**_: object) -> None:
+        if busy.pop(0):
+            raise sounddevice.PortAudioError("Device unavailable", -9985)
+
+    with (
+        patch.object(_mod, "resolve_audio_device", return_value=device),
+        patch.object(_mod, "rescan_audio_devices", side_effect=lambda: rescans.append(True)),
+        patch.object(sounddevice, "check_output_settings", side_effect=check),
+    ):
+        result = asyncio.run(_mod.wait_for_audio_device("nixtune", interval=0))
+
+    assert result is device
+    assert rescans == [True]
+
+
+def test_wait_for_audio_device_does_not_wait_for_other_errors():
+    """Only a device held elsewhere is waited for; other open errors are left to the caller."""
+    device = _nixtune_device()
+
+    with (
+        patch.object(_mod, "resolve_audio_device", return_value=device),
+        patch.object(
+            sounddevice,
+            "check_output_settings",
+            side_effect=sounddevice.PortAudioError("Invalid sample rate", -9997),
+        ),
+    ):
+        result = asyncio.run(_mod.wait_for_audio_device("nixtune", interval=0))
+
+    assert result is device
