diff --git a/sendspin/audio_devices.py b/sendspin/audio_devices.py
index eb1bf94..d6f4c4c 100644
--- a/sendspin/audio_devices.py
+++ b/sendspin/audio_devices.py
@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import asyncio
 import logging
 import subprocess
 import sys
@@ -352,3 +353,51 @@ def _try_alsa_device(name: str) -> AudioDevice | None:
         is_default=False,
         alsa_device_name=name,
     )
+
+
+def rescan_audio_devices() -> None:
+    """Make PortAudio build its device list again."""
+    sounddevice._terminate()
+    sounddevice._initialize()
+
+
+# PortAudio's paDeviceUnavailable, which its ALSA host reports for a device
+# another program has open (EBUSY).
+_PA_DEVICE_UNAVAILABLE = -9985
+
+
+def _held_elsewhere(device: AudioDevice) -> bool:
+    """Whether opening the device fails because another program has it open."""
+    try:
+        sounddevice.check_output_settings(device=device.device_id)
+    except sounddevice.PortAudioError as err:
+        return len(err.args) > 1 and err.args[1] == _PA_DEVICE_UNAVAILABLE
+    except ValueError:
+        return False
+    return False
+
+
+async def wait_for_audio_device(device_arg: str | None, interval: float = 2.0) -> AudioDevice:
+    """Resolve the device, waiting for it while another program holds it.
+
+    PortAudio leaves out a device it cannot open while it builds its device
+    list, and a listed device that another program has open (a music player
+    on the same DAC) cannot be opened or have its formats checked. Rather
+    than exit, the daemon waits, and asks PortAudio for the list again
+    before each try. Only the first wait is logged.
+    """
+    waiting_logged = False
+    while True:
+        try:
+            device = resolve_audio_device(device_arg)
+        except ValueError as err:
+            reason = str(err)
+        else:
+            if not _held_elsewhere(device):
+                return device
+            reason = f"Audio device '{device.name}' is in use by another program."
+        if not waiting_logged:
+            logger.warning("%s Waiting for it to become available.", reason)
+            waiting_logged = True
+        await asyncio.sleep(interval)
+        rescan_audio_devices()
