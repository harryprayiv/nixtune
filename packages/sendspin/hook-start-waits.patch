+    def hold_output_until(self, task: asyncio.Task[None]) -> None:
+        """Drop audio chunks until ``task`` is done.
+
+        The worker opens the audio device on the first chunk it receives, so
+        holding chunks back keeps the device closed while the start hook runs,
+        for a hook that has to free the device first. Chunks dropped here are
+        audio whose time has passed by the time the hook returns.
+        """
+        self._output_gate = task
+
     def _on_audio_chunk(
         self,
         server_timestamp_us: int,
@@ -519,6 +530,11 @@ class AudioStreamHandler:
         send_ahead_us: int,
     ) -> None:
         """Handle incoming audio chunks by enqueueing them to the sync worker."""
+        gate = self._output_gate
+        if gate is not None:
+            if not gate.done():
+                return
+            self._output_gate = None
         worker = self._audio_worker
         if worker is None or not worker.is_running():
             if not self._chunks_dropping:
