+// If port is non-zero, try the given port only.
+// If port is zero and airplay_2_port_range is zero, pick any port the kernel chooses.
+// If port is zero and airplay_2_port_range is set, pick a free port in the range
+// airplay_2_port_base to airplay_2_port_base + airplay_2_port_range - 1, so that a firewall
+// need only open that range. Only AirPlay 2's own sockets are bound with port zero.
+//
+// The walk starts one place further on at every call, so that ports are reused as late as
+// possible. A TCP port whose earlier connections are still in TIME_WAIT can not be bound again
+// without SO_REUSEADDR for about a minute, so SO_REUSEADDR is set on TCP sockets bound in the
+// range. It is not set on UDP sockets, where on Linux it would let two sockets share one port.
+int bind_socket_and_port(int type, int ip_family, const char *self_ip_address, uint32_t scope_id,
+                         uint16_t *port, int *sock) {
+  if ((*port != 0) || (config.airplay_2_port_range == 0))
+    return bind_socket_and_port_once(type, ip_family, self_ip_address, scope_id, port, sock, 0, 0);
+
+  static unsigned int next_offset = 0;
+  unsigned int start = __atomic_fetch_add(&next_offset, 1, __ATOMIC_RELAXED);
+  int reuse_address = (type == SOCK_STREAM) ? 1 : 0;
+  int ret = EADDRINUSE;
+  int tries;
+  for (tries = 0; tries < config.airplay_2_port_range; tries++) {
+    // airplay_2_port_base + airplay_2_port_range - 1 <= 65535 is checked when the settings
+    // are read, so the sum fits.
+    unsigned int offset = (start + (unsigned int)tries) % (unsigned int)config.airplay_2_port_range;
+    uint16_t candidate = (uint16_t)((unsigned int)config.airplay_2_port_base + offset);
+    ret = bind_socket_and_port_once(type, ip_family, self_ip_address, scope_id, &candidate, sock,
+                                    reuse_address, 1);
+    if (ret == 0) {
+      *port = candidate;
+      return 0;
+    }
+    if (ret != EADDRINUSE)
+      return ret;
+  }
+  warn("Could not find a free %s port between %d and %d. Check that airplay_2_port_range is large "
+       "enough.",
+       (type == SOCK_STREAM) ? "TCP" : "UDP", config.airplay_2_port_base,
+       config.airplay_2_port_base + config.airplay_2_port_range - 1);
+  return ret;
+}
