-- allium: 3
--
-- nixtune: a declarative network music player. A NixOS module
-- (services.nixtune.*) plus a PureScript (Halogen) page, built as a
-- public flake and consumed by the neoblade-config fleet as one input
-- and one row. A clean reimplementation of what moOde audio player
-- does, with none of moOde's code, none of its name, and none of its
-- runtime configuration machinery.
--
-- THIS FILE AND ITS SIBLING. This file covers the system: the module,
-- its options and units, the hardware, the library, the art cache, the
-- volume helper, the renderers and their arbitration, the fleet and the
-- maintenance loop. The page (every view, every list, every command it
-- sends, and its contracts with MPD, websocat, the helper and the art
-- cache) is specified in nixtune-page.allium, which supersedes every
-- page rule and surface earlier revisions of this file carried.
--
-- STATE OF THE WORLD, 2026-10-31, read from github:harryprayiv/nixtune
-- at 1ad560b, and revised the same evening for the `youtube` branch,
-- which the fleet input now points at (github:harryprayiv/nixtune/
-- youtube). That branch adds, on top of 1ad560b: nix/module/youtube.nix
-- (decision 27), m3u and extm3u back on in database.nix (decision 29),
-- the page's playlists, YouTube field, pinned YouTube row, Clear in place
-- of Stop and proportional list sizing (nixtune-page.allium P25 to P29),
-- and a README rewritten to describe the flake as it is. Where this file
-- and the code disagreed, the code was taken as the truth and this file
-- was changed to match it, except where a disagreement is a defect,
-- which is then a KnownIssue below.
--
--   Repositories:
--     ~/git/nixtune             the public flake, PUSHED to
--                               github:harryprayiv/nixtune.
--                               nix/module/{default,hardware,mpd,library,
--                               database,volume,art,ui,youtube,airplay,
--                               upnp}.nix,
--                               packages/upmpdcli.nix,
--                               packages/nixtune-web/, LICENSE (AGPLv3),
--                               .github/workflows/check.yml,
--                               .inference/*.allium. Its flake.lock pins
--                               nixpkgs to 6510408d (KnownIssue
--                               purescript_segfault). A devShell carries
--                               purescript, esbuild, nixfmt and spago from
--                               purescript-overlay for editing the lock;
--                               consumers never evaluate it.
--     ~/neoblade-config         the fleet. Input `nixtune` =
--                               github:harryprayiv/nixtune/youtube (the
--                               branch, until it is merged to main),
--                               nixpkgs following. The input is a GITHUB input,
--                               so a change in the working tree is
--                               invisible to the fleet until it is
--                               pushed and `nix flake update nixtune
--                               --tarball-ttl 0` has run. A night was
--                               lost to that once. Adapter role
--                               modules/system/player.nix; rows `nixtune`
--                               (aarch64, Pi) and `nixtune-vm` (x86 QEMU);
--                               facts in hosts/nixtune.nix and
--                               hosts/nixtune-vm.nix. deployAddr is the
--                               NAME nixtune.lan, which the router's DNS
--                               gives to whichever interface holds the
--                               lease.
--
--   Flake outputs, as they actually are:
--     nixosModules.default      ./nix/module (also nixosModules.nixtune).
--                               Brings its own packages, built with the
--                               importing host's pkgs; no overlay.
--     packages.<sys>.nixtune-web   the page
--     packages.<sys>.upmpdcli      unbuilt (KnownIssue upmpdcli_unbuilt)
--     checks.<sys>.nixtune-web     the page build
--     checks.x86_64-linux.rehearsal
--                               toplevel of a QEMU-shaped host with
--                               hardware.profile = "none" and one station
--     devShells.<sys>.default, formatter.<sys> (nixfmt)
--   for <sys> in x86_64-linux and aarch64-linux. There is no Pi SD image
--   output, no example host, no overlay and no pi5-sd module in this
--   flake, and the README rewritten on the youtube branch says so
--   (KnownIssue readme_stale, closed). The Pi's boot path and image come
--   from the fleet.
--
--   The library, measured 2026-10-30 and 2026-10-31: about 75.8k songs,
--   roughly 55k MP3 and 18.5k FLAC, a quarter lossless. No cover files
--   beside the audio anywhere; the art is inside the files, as ID3v2 APIC
--   frames and FLAC PICTURE blocks. Every album directory also carries
--   Synology's @eaDir and .checksums, which are pruned everywhere the
--   player walks the tree. A queue of 100 to 250 entries is an ordinary
--   working size.
--
--   The MPD this flake builds: nixpkgs 6510408d gives mpd 0.24.15 with
--   features = null, which enables every known feature, pcre, icu and
--   sqlite included. 0.24 has no window on `list`; that arrives in 0.25.
--
--   Verified on the Pi (Raspberry Pi 5 Model B Rev 1.1, HiFiBerry DAC2
--   HD, Samsung 128 GB card):
--     - Boots the generic aarch64 SD image with U-Boot chainloaded by the
--       GPU firmware.
--     - The DAC appears as ALSA card sndrpihifiberry with mixer control
--       DAC, limits 0 to 240 in 0.5 dB steps.
--     - mpd, nixtune-websocket, nginx, shairport-sync, the
--       nixtune-volume socket and its websocat bridge all active.
--     - /srv/music mounts from the Synology; the rescan timer runs two
--       minutes after boot and daily.
--     - Wifi: secrets/nixtune.yaml holds user-password and wifi-psk.
--     - YouTube (youtube branch, 2026-10-31): nixtune-youtube.socket and
--       nixtune-youtube-ws active; /srv/nixtune-youtube mounts
--       192.168.8.110:/volume2/music/Music/_youtube read-write over
--       NFSv4.1, sec=sys; a single video and a playlist fetched, written
--       to the NAS and queued.
--
--   Lessons that cost a night, written down so they are not paid twice:
--     - nixpkgs' online first-boot resize of the ext4 root corrupted
--       directory blocks across the store; grow the card OFFLINE on
--       winsmuth. KnownIssue sd_resize.
--     - MPD's auto_update installs inotify watches over the whole tree
--       on its main thread before notifying systemd; on a vast NFS
--       library this exceeded the start timeout, and inotify never fires
--       for NFS writes anyway. Off; a timer runs `mpc update`.
--     - websocat -t frames by TCP READ, not by line. One websocket
--       message can hold a whole MPD reply or stop in the middle of a
--       line. The page keeps the unfinished tail and splits on newline.
--     - Halogen renders the whole page on every state update. A reply
--       collected line by line through component state rendered the page
--       once per line; a ten thousand line `list` made opening the
--       Library take most of a minute against an MPD that answered in
--       under a second. Reply buffers live in Refs, outside the state,
--       and a whole reply costs one render (decision 25).
--     - Every file in the Nix store has mtime 1970-01-01. nginx sends
--       that as Last-Modified with no lifetime and a browser applies
--       heuristic freshness, about five years. The page is served
--       no-store with etag and if_modified_since off.
--     - MPD URIs are relative to music_directory. Changing the export
--       silently invalidates every URI in the database and the queue
--       fails without saying why. database.nix stamps the export beside
--       the database and drops the database on a mismatch.
--     - MPD closes a client whose reply overruns its output buffer.
--       `listall` on this library does it; so does an unwindowed
--       `search any` on a common word. mpd.maxOutputBuffer raises the
--       ceiling to 32768 KB and every listing the page sends is either
--       windowed or bounded by a selection. KnownIssue listall_overruns
--       is closed.
--     - Halogen writes an input's value property on every render, which
--       clears the browser's dirty flag, so a controlled input never
--       fires `change`. A typed value is committed on Enter and on blur.
--     - e2fsprogs and parted are not on winsmuth; every tool outside
--       coreutils and util-linux is invoked through `nix shell`.
--     - An option that is declared and never set contributes nothing,
--       silently: the first YouTube deploy built the branch with
--       youtube.enable unset, so no user, unit or capability existed and
--       the page looked unchanged. `nix eval .#nixosConfigurations.
--       nixtune.config.services.nixtune.youtube.path` says which it is
--       before a deploy.
--     - The Synology's NFS export with no uid mapping checks the client's
--       uid against the folder, and its POSIX mode bits do not show its
--       ACLs (the same as /volume2/git in the fleet, homelab.nas.gitUid).
--       `_youtube` reported 1034:100 drwxr-xr-x. The helper's dynamic
--       system uid (990) was refused; giving users.users.nixtune-youtube
--       the uid 1034 was not enough on its own; editing the folder's
--       permissions in DSM made writes work. hosts/nixtune.nix keeps
--       uid = 1034. NixOS does not change the uid of an account that
--       already exists ("not applying UID change"): stop the units and
--       `userdel` the account before the deploy that changes it.
--
-- Design decisions that shape this spec:
--
--   1. The only source of configuration is the Nix declaration. No
--      settings database, no settings page, no daemon that rewrites
--      /etc or /boot. Decision 21 is where this is under pressure.
--   2. Every optional capability is a sub-option with an enable flag
--      defaulting to false; a disabled one contributes nothing. Two
--      deliberate exceptions, both defaulting to true because a player
--      without them is not a useful default: ui.enable and ui.albumArt.
--   3. The page is a Halogen single page application that speaks the
--      MPD protocol itself over websockets bridged by websocat. There is
--      no application server on the Pi. Decisions 8, 14 and 15 are all
--      consequences of holding this line, and decision 22 is where it
--      would have to break.
--   4. No over the air updates. Updates arrive only as new generations.
--   5. The root filesystem is NOT ephemeral yet; the module publishes
--      persistPaths (/var/lib/mpd and, with album art, /var/lib/nixtune)
--      and the fleet adapter maps it into the manifest. persistPaths is
--      not readOnly: more than one part of the module owns state, and
--      the definitions merge.
--   6. Two layers, one boundary: the public module knows no fleet; the
--      adapter maps fleet facts into its options.
--   7. Maintenance is `nix flake update` on an update branch, CI, merge.
--      CI does not currently pass (KnownIssue ci_broken).
--
-- Decisions taken 2026-10-30 (the page as a room's player):
--   8. ROLES WITHOUT A BACKEND. Two pages from one bundle: the guest
--      page at / and the host page at ui.hostPath (default /host). The QR
--      code on the host page encodes ui.publicUrl. There is no token and
--      no rotation. Role limits are enforced by the page, not by the Pi.
--      Both pages reach the same websocket, and a guest who opens a
--      browser console can send any MPD command. This is accepted for a
--      LAN of invited people. A filtering proxy between websocat and MPD
--      is the upgrade path.
--   9. GUESTS APPEND ONLY. Detail in nixtune-page.allium.
--  10. GUEST IDENTITY IS A NICKNAME PER DEVICE (adjective plus animal),
--      kept in that browser's localStorage under nixtune.nickname, never
--      prompted for. Attribution lives in MPD stickers under
--      nixtune.added_by.
--  11. LIBRARY = Music/ ONLY. library.export points at
--      /volume2/music/Music. The first scan runs for days in the
--      background; the page shows a quiet indicator until updating_db
--      clears, and everything already scanned is browsable meanwhile.
--      database.nix disabled all nine playlist plugins so only audio was
--      indexed, which also stopped stored playlists from being LOADED.
--      Revised by decision 29: m3u and extm3u are back on, the other
--      seven stay off.
--  13. THE QR IS BUILT BY NIX: qrencode renders ui.publicUrl to qr.svg
--      in the closure. No QR library in the bundle.
--
-- Decisions taken 2026-10-30 evening, from running the thing:
--
--  12. SUPERSEDED. "No cover art" lasted one day. See decision 15.
--
--  14. THE HARDWARE VOLUME IS WRITTEN BY A HELPER, NOT BY MPD.
--      MPD sets volume through snd_mixer_selem_set_playback_dB_all
--      (src/mixer/plugins/VolumeMapping.cxx) whenever the control's dB
--      range exceeds 24 dB. The DAC2 HD's range is 120 dB, so MPD always
--      takes that path, and on this card every setvol through it lands
--      on raw 0, a hard mute that stays. Measured: five consecutive
--      setvol commands at 30, 60, 90, 40 and 75 all left the control at
--      0. The same card takes amixer writes, raw and mapped, and they
--      hold.
--      So: MPD keeps the mixer for READING, which is how the page and
--      every other client learn the level and how AirPlay changes show
--      up. WRITES go to a systemd socket-activated shell helper running
--      `amixer -M`, reached from the browser through websocat and nginx
--      at /volume. This is the split moOde uses (www/util/vol.sh calls
--      `amixer -M -c $CARDNUM sset "$AMIXNAME" $LEVEL%`), without
--      moOde's database or PHP.
--      The scale is ALSA's normalized mapping, percent = 10^(dB/60),
--      which is what both amixer -M and MPD report, so the number the
--      page sends and the number MPD sends back mean the same thing.
--      volume.path is "/volume" exactly when the output is a real ALSA
--      card and the page is enabled, and null otherwise; null means MPD's
--      own setvol is used.
--
--  15. COVER ART IS A CACHE THE PLAYER BUILDS. nginx serves files, and
--      MPD's albumart and readpicture answer with binary that a
--      text-mode websocket cannot carry. art.nix walks the library on a
--      timer, takes a picture file beside the audio (cover.*, folder.*,
--      front.*, album.*) when there is one and otherwise the embedded
--      picture of the first track with ffmpeg, and writes exactly one
--      cover.jpg per album directory under /var/lib/nixtune/art,
--      mirroring the library's layout. A directory with audio and no
--      picture gets a .none marker so it is not tried again until its
--      mtime moves. nginx serves only .jpg and .jpeg under /art/ from
--      that tree, so /art/ can never reach audio.
--      The unit runs as the fixed system user nixtune-art (a
--      DynamicUser's state lives under /var/lib/private, which nginx
--      cannot traverse), niced to 19 with idle IO and idle CPU
--      scheduling, with no network.
--
--  16. THE PAGE IS SEVERAL MODULES, NOT ONE. On the youtube branch:
--      Types, Browse, Tags, Filter, Cache, Caps, Mpd, Net, Nick, Art,
--      Reorder, Volume, Player, Library, Page, Playlists, PlaylistView,
--      Youtube, Ui and Main, 5026 lines in all. The "none over about 300
--      lines" goal does not hold: Main is 616 lines, Browse 595, Tags
--      558, Types 502, Library 464 and Mpd 404. Page, which was 782 at
--      1ad560b, split along its views into Page (357), Library and
--      Player, and each new feature arrived as a behaviour module and a
--      view module (Playlists and PlaylistView, Youtube).
--
--  17. ONE ATTRIBUTION QUERY, NOT ONE PER ENTRY. `sticker find song ""
--      nixtune.added_by` returns every attribution in one command, and
--      the page subscribes to MPD's `sticker` idle subsystem. Its growth
--      over time is an open question in nixtune-page.allium.
--
--  18. ONE TRANSPORT BAR. BUILT. The position row (elapsed, seek bar,
--      duration) directly above previous, play/pause, next, mute and the
--      level slider, on every host view; the typed level field and the
--      steppers at 30rem and up. The playback mode buttons (random,
--      repeat, single, consume) stay on Now playing. Stop is gone; Clear
--      queue, in two presses, takes its place (nixtune-page.allium P25).
--
--  19. BROWSE BY TAG, NOT ONLY BY FOLDER. BUILT, and since revised:
--      artist-first with genre as a toggle column, multi-select per
--      column, virtualized columns, a windowed track list, a letter rail
--      over 40 entries, the whole-library lists cached in localStorage
--      under MPD's db_update. The folder tree is the second mode. The
--      next revision of the browser (album artist, page-side collation,
--      regex OR, search filtering the columns, a sortable table, a
--      windowed queue) is nixtune-page.allium.
--
--  20. HOME ASSISTANT TALKS TO MPD DIRECTLY. services.nixtune.mpd.
--      exposeOnLan = true binds MPD to any address and opens 6600, and
--      HA connects to nixtune.lan:6600. It can play, pause, skip and load
--      playlists. Its volume control calls setvol, which on this card
--      mutes it, so HA is for transport and not for volume until
--      KnownIssue mpd_setvol_mutes_dac2hd closes. HA is an
--      unauthenticated client on the LAN with full MPD rights, which is
--      decision 8's trust model.
--
--  21. DSP IS A CONFIG-TIME CHOICE. MPD's filter plugins are declared in
--      mpd.conf, so a parametric EQ or a room correction curve is a
--      services.nixtune.dsp.* option and a rebuild to change it. The
--      alternative, a daemon that rewrites mpd.conf and restarts MPD, is
--      the beginning of moOde's settings database and is refused. A
--      middle path is not yet chosen: ALSA plugins (ladspa, camilladsp)
--      read their own coefficient files, which could live in a persisted
--      path that a page writes, leaving the declaration to say THAT
--      there is DSP and the file to say what it does. That still needs
--      something on the Pi that can write a file on request, which is
--      decision 22's problem. No dsp option exists yet.
--
--  22. THE DJ AMBITION FORKS HERE. Crossfade is MPD protocol and is in
--      scope. DSP is decision 21. Beat matching needs two decks sounding
--      at once, independent tempo and pitch, a cue and preview path and
--      a crossfader; MPD is one deck and one queue, and no MPD protocol
--      command will do this. A DJ console therefore means an audio engine
--      and an application server on the Pi, which contradicts decision
--      3, and is recorded as a SEPARATE PRODUCT sharing the library, the
--      hardware profile and the fleet row (section "Out of Scope").
--
-- Decisions recorded 2026-10-31, from the code as it stands:
--
--  23. PARTY MODE. party.enable (off by default) gives the guest page
--      the queue, read only, with a veto control on each entry; when
--      party.vetoes distinct guests (default 3) have voted against a
--      track it leaves the queue. The tally is an MPD sticker, so every
--      browser sees the same count and nothing on the Pi keeps score. It
--      adds no security and removes none (decision 8). The tally's
--      encoding, and the lost-vote race in today's read-modify-write of
--      a comma-separated name list, are nixtune-page.allium P16.
--
--  24. THREE CONNECTIONS TO MPD PER PAGE. cmd for transport, the queue,
--      status and stickers; idle parked in `idle`; lib for the library.
--      MPD answers one command at a time per connection in order, so a
--      library query on its own connection is never stuck behind a large
--      queue read. Each connection is its own websocat process and its
--      own MPD client. MPD's max_connections is left at its default,
--      which is far above three per open page for a room of guests.
--
--  25. REPLY BUFFERS ARE OUTSIDE COMPONENT STATE, AND A SOCKET IS THE
--      CANCEL. The lesson above. And: MPD cannot cancel a command it has
--      started, so a click that lands while the library connection is
--      busy closes that socket and opens a new one; requests made before
--      the new socket greets are queued on it and sent at the greeting.
--      Each socket carries a serial, and events from a socket that is no
--      longer the connection's are ignored, so a socket dropped on
--      purpose is never mistaken for the player going away. Each cancel
--      is one websocat process exiting and one MPD client closing; the
--      work MPD had started on it still runs to completion and is
--      discarded.
--
--  26. THE PAGE IS BUILT FROM spago.lock WITH NOTHING BUT NIXPKGS. Each
--      registry package in the lock is one fixed-output fetchurl of the
--      registry tarball, checked against the lock's integrity hash, then
--      `purs compile` and esbuild into one index.js. No network during
--      the build, no fetch during evaluation, no extra flake inputs for
--      consumers, no mkSpagoDerivation. spago is only the tool that
--      edits the lock, from the devShell. No foreign JavaScript modules
--      exist in the page.
--
-- Decisions taken 2026-10-31 evening, on the youtube branch:
--
--  27. A YOUTUBE LINK BECOMES A TRACK IN THE LIBRARY. youtube.enable
--      (off by default) adds youtube.nix: a systemd socket on
--      127.0.0.1:8603 with Accept=yes, a templated unit running a
--      writeShellApplication helper with stdin and stdout on the
--      connection, websocat bridging 127.0.0.1:8604 to it, and nginx
--      serving /youtube. The same shape as the volume helper (decision
--      14), and the same reach: anyone who can open the page. The page
--      offers it on the host page only.
--      The helper never passes the browser's URL on. It accepts a
--      youtube.com watch, shorts or live link, a youtu.be link, or a
--      youtube.com playlist link (www, m and music hosts), takes the
--      eleven-character video id or the playlist id out of it, and
--      builds the URL yt-dlp gets from the id alone. A watch link that
--      also carries list= is the one video. A playlist is listed with
--      --flat-playlist, cut at youtube.maxPlaylistItems, and each id of
--      the video id's shape goes through the single-video path in order.
--      yt-dlp runs with --ignore-config, --no-playlist, bestaudio
--      extracted without re-encoding, a match filter on duration
--      (youtube.maxMinutes) and !is_live, --max-filesize
--      (youtube.maxSize), embedded metadata and thumbnail, under flock
--      (one download at a time across every connection) and a fifteen
--      minute timeout. It works in the unit's CacheDirectory and copies
--      the result to the NAS as <name>.part, then renames it, so MPD
--      never indexes a half-written file. The name is
--      "<uploader> - <title> [<id>].<ext>"; a link whose id is already
--      in the folder is queued from the file that is there.
--      Only youtube.directory (default _youtube) at the top of the
--      library export is mounted read-write, at /srv/nixtune-youtube;
--      the library stays read-only at /srv/music. The helper then asks
--      MPD to rescan that folder and adds the file, retrying for a
--      minute and a half because the two NFS mounts cache attributes
--      separately. The unit runs as the fixed user nixtune-youtube so
--      the NAS sees one uid; the NAS's permissions on the folder are a
--      prerequisite Nix cannot set (the lesson above).
--      yt-dlp from a pin a few months old stops working as YouTube
--      changes; youtube.package is the escape hatch, and a flake update
--      the ordinary fix.
--
--  28. DOWNLOADS ARE LIBRARY, NOT CACHE. A fetched file stays in the
--      folder, is indexed like any other, and is found by search. Its
--      album artist is youtube.artist (default "YouTube"), set with
--      yt-dlp's --parse-metadata into meta_album_artist, and its album
--      is YouTube's album when there is one and the uploader otherwise.
--      capabilities.json carries youtubeArtist, and the page pins that
--      row to the top of the artist column (nixtune-page.allium P29).
--      Retagging a file with a real album artist moves it into the rest
--      of the library; renaming it without its [<id>] makes the same
--      link fetch it again. Files fetched before this decision carry no
--      such album artist and sit under their uploader until refetched.
--
--  29. STORED PLAYLISTS ARE BACK. MPD's `load` and `listplaylistinfo`
--      go through the playlist plugin registry, while `save`,
--      `playlistmove`, `playlistdelete`, `rename`, `rm` and
--      `listplaylists` work on the file directly (checked in MPD 0.24.5,
--      src/playlist/Print.cxx and src/command/PlaylistCommands.cxx). So
--      database.nix turns m3u and extm3u on and keeps pls, xspf, asx,
--      rss, flac, cue and embcue off. The library's own .m3u files are
--      indexed as a consequence and the page leaves them out of the
--      folder listing. A .cue rip is still one long track. The page's
--      playlists are nixtune-page.allium P27; Home Assistant can load
--      stored playlists too.
--
-- Earlier decisions still in force: AirPlay on, UPnP off until upmpdcli
-- builds, SD card on oracle's boot path, hardware profile from the
-- datasheet.

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    host: HostDeclaration
    player: Player
    output: OutputDevice
    module_repo: ProjectRepository
    fleet_repo: FleetConfig
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity FleetConfig {
    repo_path: String
    input_url: String
    adapter_module: String
    build_command: String
}

-- A browser on the LAN. Identity is a nickname the page made up and
-- stored in that browser; nothing on the Pi knows who anyone is.
external entity Client {
    address: String
    on_lan: Boolean
    nickname: String?
}

external entity Nas {
    address: String
    export: String
    allows: Set<String>
}

-- Anything on the LAN speaking the MPD protocol to port 6600 directly:
-- Home Assistant, mpc, a phone client. It has no page and no nickname,
-- and the player cannot tell it from any other client.
external entity ProtocolClient {
    kind: home_assistant | mpc | other
    address: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value SystemClosure {
    store_path: String
    flake_revision: String
}

value Track {
    uri: String
    title: String?
    artist: String?
    album_artist: String?
    album: String?
    genre: String?
    date: String?
    duration: Duration?
    format: AudioFormat?
}

-- What a file is, from its extension. MPD's own audio figures describe
-- what the decoder hands the DAC, which is a different question.
value AudioFormat {
    label: String
    quality: lossless | lossy
}

-- What nix/module/ui.nix writes to capabilities.json at build time,
-- field for field.
value Capabilities {
    hostname: String
    hardware: {
        profile: String
        output: alsa | null
        card: String?
        mixer: String?
    }
    modules: Set<ModuleKind>
    library: Boolean
    stations: List<RadioStation>
    websocketPath: String
    volumePath: String?
    artPath: String?
    youtubePath: String?
    youtubeArtist: String?
    maxVolume: Integer
    party: Boolean
    vetoes: Integer
    publicUrl: String
    hostPath: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract PlayerModule {
    evaluate: (declaration: HostDeclaration) -> SystemClosure

    @invariant Purity
        -- Evaluation reads only the Nix declaration and pinned inputs.

    @invariant Determinism
        -- Same declaration, same lock, same closure.

    @invariant LazyModules
        -- A disabled sub-option contributes nothing to the closure.

    @invariant NoRuntimeConfiguration
        -- Nothing in the closure writes to /etc, /boot or the store at
        -- runtime. The art cache under /var/lib/nixtune is derived data,
        -- rebuildable from the library at any time, and is declared in
        -- persistPaths only because rebuilding it is expensive. MPD's
        -- state file and database under /var/lib/mpd are MPD's own.

    @invariant FleetAgnostic
        -- The module references only nixpkgs' option tree, its own
        -- services.nixtune.*, and, when present, nixos-hardware's
        -- hardware.raspberry-pi.* (guarded with optionalAttrs, so a host
        -- without nixos-hardware evaluates).

    @invariant BuildTimeValidation
        -- The NixOS mpd module validates mpd.conf by running mpd on it at
        -- build time, so a playlist plugin name or setting MPD does not
        -- know fails the build and not the daemon.

    @guidance
        -- Options as implemented at 1ad560b:
        --   enable
        --   hardware.profile            "pi5-dac2hd" (default) | "none"
        --   library.export              "host:/path" or null
        --   wifi.ssid, wifi.pskFile     pskFile is a runtime path to an
        --                               environment file, PSK=<value>
        --   mpd.port                    6600
        --   mpd.exposeOnLan             false
        --   mpd.maxVolume               100
        --   mpd.maxOutputBuffer         "32768" (KB)
        --   mpd.consume                 null to remember, true/false to
        --                               set at every MPD start
        --   radio.stations              [{ name, url }]
        --   ui.enable                   true
        --   ui.package, ui.port (80)
        --   ui.publicUrl                http://<hostName>.lan/
        --   ui.hostPath                 /host; must match "/.+"
        --   ui.albumArt                 true
        --   ui.albumArtSize             600, between 64 and 4096
        --   party.enable                false
        --   party.vetoes                3, positive
        --   youtube.enable              false
        --   youtube.directory           "_youtube"; one path component,
        --                               [A-Za-z0-9_][A-Za-z0-9_.-]*
        --   youtube.package             pkgs.yt-dlp
        --   youtube.artist              "YouTube"; letters, digits,
        --                               space, dot, underscore, hyphen
        --   youtube.maxMinutes          20, between 1 and 600
        --   youtube.maxSize             "300M", [0-9]+[KMG]
        --   youtube.maxPlaylistItems    50, between 1 and 500
        --   arbitration.resumeAfterRenderer   true
        --   renderers.airplay.{enable,name}
        --   renderers.upnp.{enable,friendlyName,package}
        --   persistPaths (merged), output.* (internal)
        --   volume.path (internal, read-only, set by volume.nix)
        --   art.path (internal, read-only, set by art.nix)
        --   youtube.path, youtube.pinnedArtist (internal, read-only, set
        --   by youtube.nix; null unless the helper is on)
        -- Declared by earlier revisions of this file and NOT built:
        --   mpd.crossfade, mpd.mixRampDb, mpd.replayGain,
        --   ui.browseDefault, dsp.*. mpd.conf has replaygain = "off"
        --   hard-coded. They are the release step party_basics.
}

contract MpdService {
    @invariant LoopbackUnlessExposed
        -- bind_to_address 127.0.0.1, or "any" with the firewall port open
        -- when mpd.exposeOnLan.

    @invariant BitPerfectPath
        -- One ALSA output on hw:CARD=<card>,DEV=0 with mixer_type
        -- hardware, auto_resample, auto_channels and auto_format all
        -- "no". The null profile uses a null output with a software
        -- mixer.

    @invariant ReleasesTheCardOnPause
        -- close_on_pause = "yes", so a renderer can open the card while
        -- MPD is paused. AirPlay arbitration depends on it.

    @invariant NoAutoUpdate
        -- auto_update false; library.nix's timer runs `mpc update`.

    @invariant RestorePaused
        -- restore_paused true: after a reboot the queue and position come
        -- back paused rather than playing into the room.

    @invariant PlaylistPluginsForStoredPlaylistsOnly
        -- extm3u and m3u on, because `load` and `listplaylistinfo` need
        -- them for MPD's own stored playlists (decision 29). pls, xspf,
        -- asx, rss, flac, cue and embcue off. A one-file rip with a .cue
        -- is one long track. The library's .m3u files are indexed and
        -- the page does not offer them.

    @invariant MixerLevelPersists
        -- hardware.alsa.enablePersistence defaults on with an ALSA card,
        -- so the DAC's level survives a reboot.

    @guidance
        -- music_directory is /srv/music with a library, else
        -- /var/lib/mpd/music. It is never under /var/lib/mpd when NFS
        -- backs it: the mpd module turns a music_directory there into a
        -- StateDirectory, and systemd's chown on start fails on a squashed
        -- export and takes MPD down.
}

contract MpdBridge {
    status: () -> PlayerStatus
    command: (command: String) -> PlayerStatus
    capabilities: () -> Capabilities

    @invariant ReadOnlySystem
        -- Only the MPD protocol passes; capabilities.json is static.

    @invariant LanOnly
        -- nginx on 0.0.0.0:<ui.port>; websocat on 127.0.0.1:8600, the
        -- volume bridge on 127.0.0.1:8602 and the YouTube bridge on
        -- 127.0.0.1:8604; MPD on loopback unless mpd.exposeOnLan.

    @invariant NoRoleEnforcement
        -- The bridge does not know which page a socket came from.

    @invariant BoundedReplies
        -- No command the page sends can produce a reply larger than
        -- MPD's output buffer. The command-by-command bound is
        -- nixtune-page.allium's ReplyBounds.

    @guidance
        -- nixtune-websocket.service: websocat -t -E
        -- ws-l:127.0.0.1:8600 tcp:127.0.0.1:<mpd.port>, DynamicUser,
        -- restart always. nginx /ws proxies it with a one hour read
        -- timeout. One browser websocket is one websocat child and one
        -- MPD client.
}

contract VolumeWriter {
    set: (level: Integer) -> Result

    @invariant NeverMpdSetvol
        -- On a host where volume.path is non-null, the page never sends
        -- setvol. A host with the helper configured and no connection to
        -- it reports that and writes nothing, because falling back to
        -- setvol would mute the card (decision 14).

    @invariant SameScaleAsMpd
        -- amixer -M, ALSA's normalized mapping, which is the scale MPD
        -- reports.

    @invariant RejectsWhatItDoesNotUnderstand
        -- One line per request, "set N", N an integer 0 to 100. Anything
        -- else is answered with "err ..." and moves nothing.

    @guidance
        -- nixtune-volume.socket on 127.0.0.1:8601 with Accept=yes; the
        -- templated nixtune-volume@ unit runs the helper with stdin and
        -- stdout on the socket, DynamicUser in the audio group with
        -- DeviceAllow char-alsa; nixtune-volume-ws bridges 8602 to the
        -- socket; nginx serves /volume. The helper resolves the card
        -- index from /proc/asound/cards because alsa-lib reports a
        -- missing control device as an invalid card number. The glide
        -- between levels is the page's (nixtune-page.allium).
}

-- The YouTube helper (decision 27). The page's side of the line
-- protocol is nixtune-page.allium's YoutubeHelper.
contract YoutubeFetcher {
    fetch: (url: String) -> Stream<Reply>

    @invariant OnlyIdsReachYtDlp
        -- The URL yt-dlp gets is built from a video or playlist id taken
        -- out of an accepted youtube.com or youtu.be link. Anything else
        -- is answered "err not a YouTube video or playlist link" and
        -- nothing runs. No part of the line reaches a shell word.

    @invariant Bounded
        -- One video at a time across every connection (flock); per
        -- video a duration limit that also refuses live streams, a size
        -- limit and a fifteen minute timeout; per playlist
        -- youtube.maxPlaylistItems entries, listed with a two minute
        -- timeout.

    @invariant NeverAHalfFile
        -- The file reaches the NAS under a .part name and is renamed
        -- into place, and MPD is asked to index it only after that.

    @invariant WritesOneFolder
        -- ReadWritePaths is /srv/nixtune-youtube alone, mounted from
        -- <library.export>/<youtube.directory>; the library mount stays
        -- read-only. ProtectSystem strict, ProtectHome, PrivateTmp,
        -- NoNewPrivileges.

    @invariant ReusesWhatIsThere
        -- A video whose [<id>] is already in the folder is queued from
        -- that file without a download.

    @invariant FinishesWhatItStarted
        -- A connection that closes mid-request does not stop the
        -- request; the tracks still reach the queue.

    @guidance
        -- Replies, one line each: "playlist <n>", "fetching <id> <i>/<n>",
        -- "added <uri>", "skip <id> <reason>", "done <added>/<n>",
        -- "err <reason>". The unit's environment points HOME,
        -- XDG_CACHE_HOME and DENO_DIR into /var/cache/nixtune-youtube,
        -- which also holds the lock and the working directory.
}

contract ArtCache {
    cover: (album_path: String) -> Image?

    @invariant OneNamePerAlbum
        -- Exactly one file, cover.jpg, per album directory.

    @invariant NeverServesAudio
        -- The nginx location matches only .jpg and .jpeg under /art/,
        -- aliased into the cache root, which contains no audio.

    @invariant Incremental
        -- An album directory not newer than its cover.jpg or its .none
        -- marker costs a stat and nothing else.

    @invariant YieldsToPlayback
        -- Nice 19, idle IO class, idle CPU policy, PrivateNetwork,
        -- library mounted read-only into the unit.

    @guidance
        -- Served with a one hour public cache lifetime, unlike the page,
        -- because a cover file changes only when a scan rewrites it.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- What capabilities.json can list. Spotify Connect, Squeezelite,
-- Bluetooth and Roon Bridge are on the wish list (2026-10-28) and are not
-- kinds until a module exists for them.
enum ModuleKind {
    mpd
    | airplay
    | upnp_renderer
}

enum Role { host | guest }

enum NetworkKind { wired | wifi }

enum PlaybackState { playing | paused | stopped }

enum ScanState { never_scanned | scanning | scanned }

enum ReleaseStep {
    pi_plays
    | room_page
    | one_bar_and_tags
    | party_basics
    | public_release
    | arbiter_and_renderers
    | long_tail
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity HardwareProfile {
    name: String
    board: String
    output_kind: alsa | null
    dac_overlay: String?
    card: String?
    mixer_control: String?
    hardware_volume: Boolean
    mpd_can_write_mixer: Boolean
    needs_pi_kernel: Boolean
}

entity HostDeclaration {
    hostname: String
    hardware: HardwareProfile
    network: NetworkKind
    ssid: String?
    psk_file: String?
    library_export: String?
    public_url: String
    host_path: String
    consume_default: Boolean?
    expose_mpd_on_lan: Boolean
    album_art_enabled: Boolean
    party_enabled: Boolean
    party_vetoes: Integer
    youtube_enabled: Boolean
    youtube_directory: String
    youtube_artist: String
    fleet: FleetConfig?

    modules: ModuleDeclaration with host = this
    enabled_modules: modules where enabled = true
    renderers: modules where kind in {airplay, upnp_renderer}
    enabled_renderers: renderers where enabled = true

    radio_stations: RadioStation with host = this
    persisted_paths: PersistedPath with host = this
    generations: Generation with host = this
    secrets: SecretsFile? with host = this

    booted_generation: generations where status = booted
    capabilities: enabled_modules -> kind
    has_core: modules.any(m => m.kind = mpd and m.enabled)
    wifi_configured: ssid != null and psk_file != null
    needs_volume_helper: hardware.output_kind = alsa
    art_served: album_art_enabled and library_export != null
    youtube_served: youtube_enabled and library_export != null

    invariant CoreIsMandatory {
        has_core
    }

    invariant OneBootedGeneration {
        booted_generation.count <= 1
    }

    invariant AirplayNeedsCard {
        -- An assertion in airplay.nix; the build fails otherwise.
        enabled_renderers.any(r => r.kind = airplay) implies hardware.output_kind = alsa
    }

    invariant YoutubeNeedsALibrary {
        -- An assertion in youtube.nix: the download folder is a folder
        -- inside the library export.
        youtube_enabled implies library_export != null
    }

    invariant HostPathIsNotRoot {
        -- types.strMatching "/.+".
        host_path != "/"
    }

    invariant WifiWithoutSecretWarns {
        -- An ssid without pskFile writes no NetworkManager profile and
        -- emits a warning, so a host can boot on ethernet first.
        ssid != null and psk_file = null implies Warned(host)
    }

    @guidance
        -- The fleet member: hostname nixtune, deployAddr nixtune.lan,
        -- pi5-dac2hd, ssid PissiNet-5G, library export
        -- 192.168.8.110:/volume2/music/Music, AirPlay on as "nixtune",
        -- UPnP off, stations GBH 89.7 and CRB Classical 99.5,
        -- public_url http://nixtune.lan/, host_path /host,
        -- mpd.consume = true, youtube.enable = true with the defaults,
        -- users.users.nixtune-youtube.uid = 1034 (the DSM user owning
        -- Music/_youtube).
}

entity ModuleDeclaration {
    host: HostDeclaration
    kind: ModuleKind
    enabled: Boolean
    state: inactive | active
    is_renderer: kind in {airplay, upnp_renderer}

    invariant DisabledModulesAreInactive {
        not enabled implies state = inactive
    }
}

entity SecretsFile {
    host: HostDeclaration
    path: String
    has_user_password: Boolean
    has_wifi_psk: Boolean

    @guidance
        -- Created without an editor session: values staged in
        -- $XDG_RUNTIME_DIR, lengths checked, encrypted with
        -- `sops --encrypt --filename-override`, staging removed.
        -- Verification prints lengths and prefixes, never values.
}

entity OutputDevice {
    host: HostDeclaration
    profile: HardwareProfile
    owner: ModuleDeclaration?
    volume: Integer
    written_by: mpd | helper | airplay

    invariant VolumeInRange {
        volume >= 0 and volume <= 100
    }

    invariant OwnerIsEnabled {
        owner != null implies owner.enabled
    }

    invariant HelperWhereMpdCannotWrite {
        host.needs_volume_helper implies written_by != mpd
    }
}

entity Player {
    host: HostDeclaration
    state: PlaybackState
    current: QueueEntry?
    queue: List<QueueEntry>
    consume: Boolean
    scan: ScanState
    song_count: Integer
    db_update: Integer
    last_error: String?
}

-- A track in the queue with who put it there.
entity QueueEntry {
    position: Integer
    id: Integer
    track: Track
    added_by: String?
}

value PlayerStatus {
    state: PlaybackState
    current: QueueEntry?
    volume: Integer?
    queue_length: Integer
    consume: Boolean
    scan: ScanState
    song_count: Integer
}

entity RadioStation {
    host: HostDeclaration
    name: String
    stream_url: String
    verified: Boolean
}

entity PersistedPath {
    host: HostDeclaration
    path: String
}

entity Generation {
    host: HostDeclaration
    closure: SystemClosure
    status: built | booted | previous | discarded
    built_at: Timestamp

    transitions status {
        built -> booted
        built -> discarded
        booted -> previous
        previous -> booted
        previous -> discarded
        terminal: discarded
    }
}

entity ProjectRepository {
    path: String
    public_url: String?
    main_revision: String
    nixpkgs_pin: String
    runs: UpdateRun with repo = this
    open_runs: runs where status in {opened, checked}
    issues: KnownIssue with repo = this

    invariant OneUpdateRunAtATime {
        open_runs.count <= 1
    }
}

entity UpdateRun {
    repo: ProjectRepository
    branch: String
    status: opened | checked | merged | abandoned
    ci_passed: Boolean
    lock_revision: String

    transitions status {
        opened -> checked
        opened -> abandoned
        checked -> merged
        checked -> abandoned
        terminal: merged, abandoned
    }
}

entity KnownIssue {
    repo: ProjectRepository
    name: String
    status: open | closed
    effect: String
    closes_when: String
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    mpd_port: Integer = 6600
    ui_port: Integer = 80
    websocket_port: Integer = 8600
    volume_socket_port: Integer = 8601
    volume_bridge_port: Integer = 8602
    youtube_socket_port: Integer = 8603
    youtube_bridge_port: Integer = 8604
    youtube_video_timeout: Duration = 15.minutes
    youtube_list_timeout: Duration = 2.minutes
    youtube_index_retries: Integer = 18
    youtube_index_retry_every: Duration = 5.seconds
    upnp_port: Integer = 49152
    max_volume: Integer = 100
    max_output_buffer_kb: Integer = 32768
    rescan_after_boot: Duration = 2.minutes
    rescan_every: Duration = 1.day
    art_scan_after_boot: Duration = 10.minutes
    art_scan_every: Duration = 6.hours
    art_long_edge: Integer = 600
    art_cache_lifetime: Duration = 1.hour
    nfs_idle_unmount: Duration = 10.minutes
    nfs_mount_timeout: Duration = 30.seconds
    mpd_defaults_retries: Integer = 5
    default_vetoes: Integer = 3
    resume_mpd_after_renderer: Boolean = true
    current_step: ReleaseStep = party_basics
}

