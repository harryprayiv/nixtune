default KnownIssue sd_resize = {
    repo: nixtune,
    name: "sd-image's online first-boot resize corrupts the root filesystem",
    status: open,
    effect: "a card that boots straight from the image as built loses directory blocks in the store; the workaround is the offline grow on winsmuth before first boot",
    closes_when: "sdImage.expandOnBoot = false in the nixtune row's extraModules (and oracle's), the offline grow written into the first-boot header of hosts/nixtune.nix, and the cause reported upstream with the e2fsck transcript"
}

default KnownIssue upmpdcli_unbuilt = {
    repo: nixtune,
    name: "upmpdcli hashes are lib.fakeHash",
    status: open,
    effect: "renderers.upnp cannot be enabled; packages.<sys>.upmpdcli fails to build",
    closes_when: "nix build ~/git/nixtune#upmpdcli has been through all three hash errors (libnpupnp 6.2.1, libupnpp 1.0.2, upmpdcli); versions unverified"
}

default KnownIssue purescript_segfault = {
    repo: nixtune,
    name: "nixpkgs' prebuilt purs 0.15.15 segfaults on nixos-unstable newer than the pin",
    status: open,
    effect: "the public repo's lock stays on the fleet's nixpkgs revision",
    closes_when: "a newer nixpkgs builds purescript, or the page build switches to a purs built from source"
}

default KnownIssue no_impermanence = {
    repo: nixtune,
    name: "ext4 root without wipe-on-boot",
    status: open,
    effect: "the fleet's ext4-root warning; persistPaths mapped but inert",
    closes_when: "the rollback cycle has been rehearsed on a Pi and both Pi rows adopt it together"
}

default KnownIssue oracle_uboot = {
    repo: nixtune,
    name: "oracle's image would not boot if rebuilt",
    status: open,
    effect: "hosts/oracle.nix does not set hardware.raspberry-pi.firmware.uboot.enable",
    closes_when: "the option is added to hosts/oracle.nix in its own fleet commit"
}

default KnownIssue mpd_setvol_mutes_dac2hd = {
    repo: nixtune,
    name: "MPD's dB write path hard-mutes the HiFiBerry DAC2 HD",
    status: open,
    effect: "every setvol on this card lands on raw 0; worked around by volume.nix, which means any OTHER MPD client on the LAN, Home Assistant included, still mutes the room when it sets volume",
    closes_when: "MPD is patched or configured to take the raw write path on a control with a wide dB range, or the helper is reachable to every client, which it is not"
}

default KnownIssue listall_overruns = {
    repo: nixtune,
    name: "MPD closes the connection when a reply overruns its output buffer",
    status: closed,
    effect: "was: `mpc listall` and an unwindowed `search any` dropped the client on this library",
    closes_when: "closed: mpd.maxOutputBuffer = 32768 KB, and every listing the page sends is windowed or bounded by a selection (nixtune-page.allium ReplyBounds)"
}

default KnownIssue airplay_owns_mixer = {
    repo: nixtune,
    name: "shairport-sync is still given the hardware mixer",
    status: open,
    effect: "airplay.nix sets mixer_control_name and mixer_device, so an AirPlay sender moves the DAC's level behind the page and behind the volume helper, through shairport-sync's own write path, which has not been measured on this card",
    closes_when: "either mixer_control_name and mixer_device are removed so AirPlay volume is software gain in its own stream, or a measurement shows shairport-sync's writes hold on the DAC2 HD and the sharing is chosen on purpose and written down here"
}

default KnownIssue ci_broken = {
    repo: nixtune,
    name: "the CI workflow builds outputs the flake does not have",
    status: open,
    effect: ".github/workflows/check.yml runs `nix build .#web` and `nix build .#checks.x86_64-linux.example-eval`; the flake has packages.<sys>.nixtune-web and checks.x86_64-linux.rehearsal. Every run fails at the second step, so decision 7's loop has no check in it",
    closes_when: "the workflow builds .#nixtune-web and .#checks.x86_64-linux.rehearsal (or runs `nix flake check` without --no-build, which builds every check), and a run on main passes"
}

default KnownIssue readme_stale = {
    repo: nixtune,
    name: "the README describes a flake that no longer exists",
    status: closed,
    effect: "it names nixosModules.pi5-sd, overlays.default, pkgs.nixtune.web, nixosConfigurations.example, packages.aarch64-linux.image, nix/hosts/example.nix, nix/modules/hardware.nix, web/ and mkSpagoDerivation; none exist. An adopter following it cannot build anything",
    closes_when: "closed on the youtube branch, 2026-10-31: the README describes the outputs listed at the top of this file, every option, the page build of decision 26, the YouTube setup, the known issues, and that a consumer supplies the Pi boot path"
}

default KnownIssue stored_playlists_unloadable = {
    repo: nixtune,
    name: "stored playlists can be saved and not loaded",
    status: closed,
    effect: "was: database.nix disabled every playlist plugin, and `load` and `listplaylistinfo` go through the same plugin registry, so `save` worked and `load` failed",
    closes_when: "closed on the youtube branch, 2026-10-31: m3u and extm3u re-enabled in database.nix (decision 29), and the page leaves the library's own playlist entries out of the folder listing"
}

default KnownIssue page_lists_unwindowed = {
    repo: nixtune,
    name: "the page reads the queue and an open saved playlist whole",
    status: open,
    effect: "`playlistinfo` with no range on opening the Queue view and on every playlist idle event, and `listplaylistinfo NAME` with no range for an open saved playlist, against nixtune-page.allium P4 and P11. A few hundred rows at this household's sizes, so neither is near the output buffer, but each playlist change rereads the whole queue",
    closes_when: "the queue is read in windows with plchanges (nixtune-page.allium P11) and an open playlist with `listplaylistinfo NAME A:B` beside `playlistlength NAME`"
}

default KnownIssue youtube_folder_permissions = {
    repo: nixtune,
    name: "the YouTube folder's write permission lives on the NAS",
    status: open,
    effect: "the helper can write only if the NAS lets the nixtune-youtube uid write to youtube.directory, which Nix cannot declare. On the fleet's Synology it took a DSM permission edit on Music/_youtube beside uid = 1034; a fresh NAS or a recreated folder needs the same by hand. The failure is `cp: cannot create regular file ... Permission denied` in the journal and `Not queued: could not write to the NAS folder` on the page",
    closes_when: "the permission requirement is a documented first-deploy step in hosts/nixtune.nix's header beside the NFS notes, or the export is given a uid mapping chosen on purpose"
}

default KnownIssue stale_gitignore = {
    repo: nixtune,
    name: "a second ignore file named gitignore",
    status: open,
    effect: "a file called gitignore (no dot) lists web/ paths from the old layout; git reads only .gitignore, so it does nothing and misleads",
    closes_when: "gitignore is deleted"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Boot and generations -----------------------------------------------

rule HostBootsGeneration {
    when: HostBoots(generation)
    requires: generation.status = built
    let current = host.booted_generation
    ensures:
        for g in current:
            g.status = previous
        generation.status = booted
        CoreStarted(host: host)
}

rule OperatorRollsBack {
    when: OperatorRollsBack(operator, generation)
    requires: generation.status = previous
    let current = host.booted_generation
    ensures:
        for g in current:
            g.status = previous
        generation.status = booted
}

rule DatabaseDroppedOnExportChange {
    when: CoreStarting(host)
    requires: RecordedExport(host) != (host.library_export or "(none)")
    ensures:
        MpdDatabaseRemoved(host: host)
        RecordedExport(host) = host.library_export or "(none)"

    @guidance
        -- nixtune-database-stamp, a oneshot wanted by and ordered before
        -- mpd.service, without RemainAfterExit so it runs on every MPD
        -- start. The stamp is $dataDir/nixtune-export. wantedBy rather
        -- than requiredBy: if the stamp unit fails, MPD still starts.
}

rule CoreStartsOnBoot {
    when: CoreStarted(host)
    let core = ModuleDeclaration{host: host, kind: mpd}
    requires: exists core
    requires: core.enabled
    ensures:
        core.state = active
        output.owner = core
        player.state = if RememberedPlaying(host): paused else: stopped
        PlaybackModesApplied(player: player)
        for m in host.enabled_modules where kind != mpd:
            m.state = active

    @guidance
        -- MPD starts after network-online and srv-music.automount, with
        -- auto_update off, so it reports ready at once regardless of
        -- library size. restore_paused brings a remembered queue back
        -- paused.
}

rule PlaybackModesApplied {
    when: PlaybackModesApplied(player)
    requires: host.consume_default != null
    ensures:
        player.consume = host.consume_default
        PlayerStatusChanged(player: player)

    @guidance
        -- nixtune-mpd-defaults.service, a DynamicUser oneshot after
        -- mpd.service, exists only when mpd.consume is non-null. It runs
        -- `mpc consume on|off`, five tries a second apart, and gives up
        -- with a journal line rather than failing the boot. MPD remembers
        -- consume, random, repeat, single and crossfade in its state file,
        -- so a declared value overrides that at every start and the
        -- page's toggle still changes it until the next start. Only
        -- consume is declared today; crossfade would follow the same
        -- shape (release step party_basics).
}

-- Library scanning ------------------------------------------------------

rule LibraryMounts {
    when: MountRequested(host)
    requires: host.library_export != null
    ensures: MountedReadOnly(host.library_export, "/srv/music")

    @guidance
        -- NFS, ro, noatime, noauto with x-systemd.automount, idle unmount
        -- after ten minutes, mount timeout 30s, _netdev and an explicit
        -- requires/after on network-online.target (the first boot showed
        -- MPD triggering the automount before the interface had an
        -- address). soft, timeo=150, retrans=3, so a NAS that stops
        -- answering gives MPD an error rather than a process stuck in the
        -- kernel. nofail, so a NAS that is down does not block boot.
}

rule RescanTimerFires {
    when: RescanDue(host)
    requires: host.library_export != null
    requires: player.scan != scanning
    ensures:
        player.scan = scanning
        PlayerStatusChanged(player: player)

    @guidance
        -- nixtune-library-update.timer: OnBootSec 2min, OnUnitActiveSec
        -- 1d; the service runs `mpc update` as a DynamicUser. An unchanged
        -- tree costs MPD a walk comparing mtimes.
}

rule ScanCompletes {
    when: MpdUpdateFinished(player, stamp)
    requires: player.scan = scanning
    ensures:
        player.scan = scanned
        player.db_update = stamp
        PlayerStatusChanged(player: player)

    @guidance
        -- db_update in `stats` is what the page keys its library cache
        -- on, so a finished scan is also what invalidates every browser's
        -- cached tag lists.
}

-- Cover art ---------------------------------------------------------------

rule ArtScanRuns {
    when: ArtScanDue(host)
    requires: host.art_served
    ensures:
        for d in AlbumDirectories(host) where Changed(d):
            if PictureFileIn(d) != null:
                CoverWritten(album: d, from: PictureFileIn(d))
            else if FirstTrackOf(d) != null and EmbeddedPictureIn(FirstTrackOf(d)) != null:
                CoverWritten(album: d, from: FirstTrackOf(d))
            else if FirstTrackOf(d) != null:
                NoCoverMarked(album: d)

    @guidance
        -- nixtune-art-scan.timer: OnBootSec 10min, OnUnitActiveSec 6h,
        -- Persistent. The unit declares RequiresMountsFor /srv/music,
        -- because a service runs in its own mount namespace and an
        -- automount that happens after the unit starts never appears
        -- inside it. ffmpeg takes one frame of the first video stream and
        -- scales it down only when wider than ui.albumArtSize. A
        -- directory with neither a picture nor audio gets nothing and
        -- costs a walk. The run ends with one journal line: covers
        -- written, already current, albums with no picture.
}

-- YouTube -------------------------------------------------------------------

rule YoutubeLinkFetched {
    when: YoutubeLine(line)
    requires: host.youtube_served
    ensures:
        if not AcceptedLink(line):
            Replied("err not a YouTube video or playlist link")
        else:
            for id in IdsOf(line) taking youtube.maxPlaylistItems:
                Replied("fetching " + id + " " + Step(id))
                if FileWithIdIn(host.youtube_directory, id) = null:
                    Downloaded(id)
                if Downloaded(id) or FileWithIdIn(host.youtube_directory, id) != null:
                    MpdRescanned(host.youtube_directory)
                    MpdProtocol.apply(player, "add " + UriOf(id))
                    Replied("added " + UriOf(id))
                else:
                    Replied("skip " + id + " " + Reason(id))
            Replied("done " + Added() + "/" + Count())

    @guidance
        -- AcceptedLink, the id extraction and every limit are contract
        -- YoutubeFetcher. A playlist that cannot be listed answers
        -- "err <reason>" in place of the per-video lines.
}

rule DownloadTagged {
    when: Downloaded(id)
    ensures:
        AlbumArtistOf(id) = host.youtube_artist
        AlbumOf(id) = YoutubeAlbum(id) or UploaderOf(id)

    @guidance
        -- Decision 28. --parse-metadata "%(nixtune_unset|<artist>)s:
        -- %(meta_album_artist)s" and "%(album,uploader)s:%(meta_album)s";
        -- checked with yt-dlp 2026.10.26, which writes ALBUMARTIST and
        -- ALBUM into an Opus file's Vorbis comment.
}

-- Volume ------------------------------------------------------------------

rule HelperWritesVolume {
    when: VolumeLine(line)
    requires: host.needs_volume_helper
    ensures:
        if line matches "set N" and N in 0..100:
            output.volume = N
            output.written_by = helper
            Replied("ok N")
        else:
            Replied("err ...")
}

rule ProtocolClientSetsVolume {
    when: ProtocolClientCommands(protocol_client, "setvol", level)
    requires: host.expose_mpd_on_lan
    ensures:
        MpdProtocol.apply(player, "setvol " + level)
        if host.needs_volume_helper:
            OutputMuted(output: output)

    @guidance
        -- A real consequence and not a hypothetical: Home Assistant's
        -- media_player.volume_set sends setvol, and on this card that
        -- silences the room. Use HA for transport until KnownIssue
        -- mpd_setvol_mutes_dac2hd closes.
}

-- Output arbitration ------------------------------------------------------

rule AirplayAcquiresOutput {
    when: RendererStreamStarts(module)
    requires: module.kind = airplay
    requires: module.state = active
    ensures:
        if player.state = playing:
            player.state = paused
            PausedByRenderer(marker: true)
        output.owner = module
        PlayerStatusChanged(player: player)

    @guidance
        -- shairport-sync's run_this_before_play_begins, with
        -- wait_for_completion: `mpc status`, and if it says [playing],
        -- touch /run/shairport-sync/nixtune-paused-mpd and `mpc pause`.
        -- MPD's close_on_pause frees the card before shairport-sync
        -- opens it. The marker lives in shairport-sync's own
        -- RuntimeDirectory, so nothing survives a reboot.
}

rule AirplayReleasesOutput {
    when: RendererStreamStops(module)
    requires: module.kind = airplay
    requires: output.owner = module
    let core = ModuleDeclaration{host: host, kind: mpd}
    ensures:
        output.owner = core
        if PausedByRenderer(marker: true):
            PausedByRenderer(marker: false)
            if config.resume_mpd_after_renderer:
                player.state = playing
        PlayerStatusChanged(player: player)

    @guidance
        -- run_this_after_play_ends: if the marker exists, remove it, and
        -- `mpc play` when arbitration.resumeAfterRenderer. MPD was not
        -- paused by AirPlay if the marker is absent, and is then left
        -- alone.
}

rule UpnpDrivesMpd {
    when: UpnpControllerPlays(module, uri)
    requires: module.kind = upnp_renderer
    requires: module.enabled
    ensures:
        MpdProtocol.apply(player, "add " + uri)
        PlayerStatusChanged(player: player)

    @guidance
        -- upmpdcli opens no audio device; it drives MPD over the
        -- protocol (ownqueue, openhome), so a UPnP controller playing
        -- something is MPD playing something and needs no arbitration.
        -- TCP 49152 and UDP 1900 (SSDP) are opened. Unbuildable today
        -- (KnownIssue upmpdcli_unbuilt).
}

-- Project maintenance ---------------------------------------------------

rule MaintainerOpensUpdateRun {
    when: MaintainerRunsFlakeUpdate(maintainer)
    requires: module_repo.open_runs.count = 0
    ensures:
        UpdateRun.created(repo: module_repo, branch: "update", status: opened, ci_passed: false, lock_revision: "")
}

rule CiChecksUpdateRun {
    when: CiCompletes(run, passed)
    requires: run.status = opened
    ensures:
        run.status = checked
        run.ci_passed = passed

    @guidance
        -- What CI should run, given the outputs that exist:
        -- `nix flake check --no-build`, `nix build .#nixtune-web`,
        -- `nix build .#checks.x86_64-linux.rehearsal`. Today it runs two
        -- that do not exist (KnownIssue ci_broken).
}

rule MaintainerMergesUpdateRun {
    when: MaintainerMerges(maintainer, run)
    requires: run.status = checked
    requires: run.ci_passed
    ensures:
        run.status = merged
        module_repo.main_revision = run.lock_revision
        FleetInputBumped(fleet: fleet_repo, revision: run.lock_revision)
}

rule PageLockEdited {
    when: MaintainerEditsPageDependencies(maintainer)
    ensures:
        SpagoLockUpdated(path: "packages/nixtune-web/spago.lock")
        PageRebuiltFromLock()

    @guidance
        -- From the devShell, in packages/nixtune-web: `spago install` or
        -- `spago upgrade`, then commit spago.yaml and spago.lock
        -- together. The build reads the lock and nothing else; a git or
        -- local dependency in it fails the build with an assertion,
        -- because only registry tarballs are fetched (decision 26).
}

rule MaintainerClosesIssue {
    when: IssueFixed(issue, revision)
    requires: issue.status = open
    ensures: issue.status = closed
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SingleOutputOwner {
    for d in OutputDevices:
        d.owner != null implies d.owner.state = active
}

invariant NicknamesAreBrowserState {
    for c in Clients:
        c.nickname != null implies StoredIn(c.nickname, "localStorage")
}

invariant ScanNeverBlocksStart {
    for p in Players:
        p.scan = scanning implies ModuleDeclaration{host: p.host, kind: mpd}.state = active
}

invariant PageNeverSetvolsAHelperHost {
    for h in HostDeclarations where needs_volume_helper:
        not PageSends(h, "setvol")
}

invariant YoutubeWritesOnlyItsFolder {
    for w in YoutubeHelperWrites:
        Under(w, "/srv/nixtune-youtube") or Under(w, "/var/cache/nixtune-youtube")
}

invariant LibraryMountStaysReadOnly {
    for h in HostDeclarations where library_export != null:
        MountedReadOnly(h.library_export, "/srv/music")
}

invariant ArtNeverServesAudio {
    for r in ArtRequests:
        Served(r) implies Extension(r) in {"jpg", "jpeg"} and Under(r, "/var/lib/nixtune/art")
}

invariant MainIsAlwaysChecked {
    -- Violated today (KnownIssue ci_broken): no run passes, so nothing
    -- merged since the workflow last matched the flake was checked.
    for r in UpdateRuns:
        r.status = merged implies r.ci_passed
}

invariant UpnpOffWhileUnbuilt {
    for h in HostDeclarations:
        upmpdcli_unbuilt.status = open implies not h.enabled_renderers.any(r => r.kind = upnp_renderer)
}

invariant NoForeignJavaScript {
    -- Decision 26. The page's foreign module budget is
    -- nixtune-page.allium's ForeignBudget, and it is empty.
    for f in PageSources:
        f.extension = "purs"
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Operator {
    identified_by: Client where on_lan = true
}

actor Maintainer {
    identified_by: Client where on_lan = true
}

actor Automation {
    identified_by: ProtocolClient where kind = home_assistant
}

-- Guest and Host are nixtune-page.allium's actors.

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- GuestPage and HostPage: see nixtune-page.allium.

surface Automation {
    facing automation: Automation

    exposes:
        player.state
        player.current
        player.queue
        output.volume

    provides:
        ProtocolClientCommands(protocol_client, command, argument)

    contracts:
        demands MpdBridge

    @guarantee NothingIsAdded
        -- Home Assistant speaks the MPD protocol on port 6600. The
        -- module contributes one boolean, mpd.exposeOnLan, and a
        -- firewall port. There is no nixtune-specific integration, no
        -- API and no second protocol.

    @guarantee SameTrustAsTheRoom
        -- An unauthenticated client on the LAN with full MPD rights,
        -- which is decision 8's trust model applied to a different kind
        -- of client.

    @guidance
        -- Transport, queue and playlist control work, loading stored
        -- playlists included since decision 29. Volume does not: see
        -- KnownIssue mpd_setvol_mutes_dac2hd and rule
        -- ProtocolClientSetsVolume.
}

surface FleetDeployment {
    facing operator: Operator

    exposes:
        host.hostname
        host.network
        for g in host.generations:
            g.status
        for i in module_repo.issues where status = open:
            i.name
            i.effect

    provides:
        OperatorRollsBack(operator, generation) when host.generations.any(g => g.status = previous)

    contracts:
        demands PlayerModule

    @guarantee FleetShape
        -- One row, one adapter, two host files; deployAddr is a name.

    @guidance
        -- Day to day: edit ~/git/nixtune, commit, PUSH, then in the
        -- fleet `nix flake update nixtune --tarball-ttl 0`,
        -- `./build check`, `./build deploy-native nixtune`, live with
        -- it, `./build boot-native nixtune`. The push is not optional:
        -- the input is a GitHub input and an unpushed change is
        -- invisible to the fleet.
}

surface CommunityFlake {
    facing adopter: Operator

    exposes:
        module_repo.public_url
        module_repo.nixpkgs_pin
        for i in module_repo.issues where status = open:
            i.name

    contracts:
        demands PlayerModule

    @guarantee StandaloneUse
        -- Import nixosModules.default and set services.nixtune.*. For the
        -- Pi profile, also import nixos-hardware's raspberry-pi-5 module
        -- and supply a boot path; this flake does not provide one.

    @guidance
        -- AGPLv3, LICENSE present. No moOde code or name. The README on
        -- the youtube branch is the adopter's guide.
}

------------------------------------------------------------
-- Release steps
------------------------------------------------------------

-- pi_plays               DONE 2026-10-30.
-- room_page              DONE 2026-10-30.
-- one_bar_and_tags       BUILT; revised by nixtune-page.allium, whose
--                        IMPLEMENTATION STATUS says what of it is built.
-- party_basics           IN PROGRESS. Done on the youtube branch: m3u
--                        and extm3u back on and saved playlists on the
--                        page (decision 29), YouTube links (decisions 27
--                        and 28). Still to do: mpd.crossfade (and
--                        mixRampDb), mpd.replayGain replacing the
--                        hard-coded "off", applied at start the way
--                        mpd.consume is; the AirPlay mixer decision;
--                        merging the youtube branch to main.
-- public_release         ci_broken and readme_stale closed, an example
--                        host and a Pi image output in the flake.
-- arbiter_and_renderers  upmpdcli built; Spotify Connect, Squeezelite,
--                        Bluetooth as off-by-default modules.
-- long_tail              the 2026-10-28 wish list: multiroom, HTTP
--                        stream out, a USB DAC profile, more HiFiBerry
--                        profiles, kiosk display, GPIO/rotary, IR, USB
--                        and SMB sources, favorites, runtime station add,
--                        a fallback access point, ListenBrainz.

------------------------------------------------------------
-- Out of Scope: the DJ console
------------------------------------------------------------

-- Recorded here rather than as a release step, because it is a
-- different product. Decision 22.
--
--   What it needs that MPD cannot give:
--     - two decks sounding at once, each with its own transport
--     - independent tempo and pitch, with time-stretch, per deck
--     - cue points, and a preview path that is not the room's output
--     - a crossfader, and per-deck gain and EQ
--     - beat and tempo detection, offline, cached per track
--   What that implies:
--     - an audio engine on the Pi, which is an application server, which
--       contradicts decision 3
--     - state that outlives a generation (cue points, analysis, crates),
--       which contradicts decision 1 unless it is declared data rather
--       than configuration
--     - a second ALSA client, or one engine that owns the card and MPD
--       feeding it, which changes the arbitration story completely
--
--   What it would share with nixtune: the library and its mount, the
--   hardware profile, the volume helper, the art cache, the fleet row,
--   and the page's design language.
--
--   What is in scope for nixtune and covers most of a party: crossfade,
--   consume as the default queue discipline, replay gain, party mode,
--   a queue that is pleasant to reorder under load, and the tag browser.

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred Nixtune.page               -- see: nixtune-page.allium
deferred MpdProtocol.apply          -- see: https://mpd.readthedocs.io/en/latest/protocol.html
deferred MpdProtocol.stickers       -- see: the sticker commands in the same document
deferred MpdProtocol.crossfade      -- see: crossfade, mixrampdb, mixrampdelay
deferred Firmware.configtxt         -- see: nixos-hardware raspberry-pi/README.md
deferred Renderer.airplay           -- see: shairport-sync documentation, sessioncontrol
deferred Renderer.upnp_renderer     -- see: upmpdcli documentation
deferred Websocket.bridge           -- see: websocat documentation
deferred Fetcher.ytdlp              -- see: yt-dlp README, output templates, --parse-metadata, --match-filter
deferred AlsaMixer.mapped           -- see: amixer -M and ALSA's normalized volume mapping
deferred Automation.homeassistant   -- see: Home Assistant's MPD integration
deferred Fleet.rows                 -- see: neoblade-config.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Whether page-side role limits (decision 8) stay acceptable once the player is used by people outside the household; the upgrade is a filtering proxy between websocat and MPD, which is the backend the decision avoided."
open question "How a protocol client such as Home Assistant should set volume on a card MPD cannot write. A filtering proxy on 6600 that rewrites setvol into a call to the helper would fix it and would also give decision 8 its enforcement point, which suggests both problems have one answer."
open question "Whether shairport-sync's own mixer writes hold on the DAC2 HD, or hit the same dB-path mute MPD's do. airplay.nix gives it the hardware mixer today and nobody has moved the volume from an AirPlay sender and read the control back."
open question "Whether DSP should be a declared option with a rebuild to change it, or a declared option plus a coefficient file in a persisted path that something on the Pi can write. The second is better to use and is the first crack in decision 1."
open question "Whether the DJ console is built beside nixtune sharing its library and hardware layer, or whether nixtune's page grows a second mode and the no-backend decision is dropped. The spec assumes the first; nothing has been built either way."
open question "Whether the Pi image and boot path should move into this flake (an example host and an image output) for public_release, or stay in the fleet with the README telling adopters to bring their own."
open question "Why nixpkgs' online expandOnBoot resize corrupted directory blocks on this card and kernel, and whether it reproduces on a second card."
open question "Whether the uid = 1034 line in hosts/nixtune.nix is still needed now that the folder's DSM permissions were edited, or whether the edit alone (for example a permission granted to everyone) is what made writes work. One test with the line removed settles it, and the answer decides what KnownIssue youtube_folder_permissions tells a second adopter to do."
open question "Whether downloads should ever leave youtube.directory on their own, for example a tool that moves a retagged file into the library proper. Today a file stays where it landed, which keeps the helper writing one folder and nothing else."
